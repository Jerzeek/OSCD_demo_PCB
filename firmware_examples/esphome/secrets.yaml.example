# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — never commit it.

wifi_ssid: "your-network"
wifi_password: "your-password"
fallback_password: "fallback-ap-password"

# Generate with: openssl rand -base64 32
api_encryption_key: "base64-32-byte-key-goes-here"

ota_password: "choose-an-ota-password"
